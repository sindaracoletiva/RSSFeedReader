@page "/subscriptions"
@using RSSFeedReader.UI.Services
@inject SubscriptionClient SubscriptionClient

<PageTitle>Subscriptions</PageTitle>

<h1>RSS subscriptions</h1>

<EditForm Model="_formModel" OnValidSubmit="AddSubscriptionAsync">
    <div class="mb-3">
        <label for="feedUrl" class="form-label">Feed URL</label>
        <InputText id="feedUrl" @bind-Value="_formModel.Url" class="form-control" />
    </div>

    <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">Add subscription</button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger mt-3" role="alert">
        @_errorMessage
    </div>
}

@if (_isLoading)
{
    <p class="mt-3">Loading subscriptions...</p>
}
else if (_subscriptions.Count == 0)
{
    <p class="mt-3">No subscriptions yet. Add one to begin tracking a feed.</p>
}
else
{
    <ul class="list-group mt-3">
        @foreach (var subscription in _subscriptions)
        {
            <li class="list-group-item">@subscription.Url</li>
        }
    </ul>
}

@code {
    private readonly SubscriptionFormModel _formModel = new();
    private readonly List<SubscriptionItem> _subscriptions = new();
    private string? _errorMessage;
    private bool _isLoading;
    private bool _isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        await LoadSubscriptionsAsync();
    }

    private async Task LoadSubscriptionsAsync()
    {
        _isLoading = true;
        try
        {
            _subscriptions.Clear();
            var items = await SubscriptionClient.GetSubscriptionsAsync();
            foreach (var item in items)
            {
                _subscriptions.Add(item);
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AddSubscriptionAsync()
    {
        _errorMessage = string.Empty;
        _isSubmitting = true;

        try
        {
            var url = _formModel.Url?.Trim();
            if (string.IsNullOrWhiteSpace(url))
            {
                _errorMessage = "Enter a valid RSS or Atom feed URL.";
                return;
            }

            var item = await SubscriptionClient.AddSubscriptionAsync(url);
            if (item is not null)
            {
                _subscriptions.Add(item);
                _formModel.Url = string.Empty;
            }
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private class SubscriptionFormModel
    {
        public string? Url { get; set; }
    }
}
